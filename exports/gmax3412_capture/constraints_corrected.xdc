# Input clock periods. These duplicate the values entered for the
# input clocks. You can use these to time your system. If required
# commented constraints can be used in the top level xdc
#----------------------------------------------------------------
#create_clock -period 10.000 [get_ports clk_in1]
#set_input_jitter [get_clocks -of_objects [get_ports clk_in1]] 0.1


current_instance -quiet
current_instance u_design_1_wrapper/design_1_i/gmax_emu_clock/inst
set_property PHASESHIFT_MODE LATENCY [get_cells -hierarchical *adv*]

# User Generated miscellaneous constraints 

current_instance -quiet
set_property MARK_DEBUG true [get_nets -quiet -of_objects [get_pins -quiet -hier -filter {NAME == "u_gmax_a_rx/u_training/loopi[0].u_iserdes/data_val_reg/Q"}]]
set_property MARK_DEBUG true [get_nets -quiet -of_objects [get_pins -quiet -hier -filter {NAME == "u_gmax_a_rx/u_training/loopi[0].u_iserdes/ISERDESE3_inst/RST"}]]

####################################################################################
# Constraints from file : 'fh_pcie_refclk_monitor.xdc'
####################################################################################

# Revision trace
# 2026-10-02 FH-4 - Synthesis-safe base constraints
#                     Keep only package pins and the 100 MHz primary input clock.
#                     The auto-derived ODIV2 clock and clk_pl_0 relationship are
#                     handled after synthesis in FH_Carrier_Bringup_impl.xdc.
#                     This avoids Critical Warnings while the BD module is black-boxed.
# 2026-10-02 FH-3 - Define ODIV2 explicitly and group the full PCIe clock family
#                     asynchronously from clk_pl_0.  This removes the guarded
#                     auto-derived-clock query that could silently skip the
#                     clock-group constraint and leave TIMING-6/TIMING-7.
# 2026-10-02 FH-2 - Reference the auto-derived ODIV2 clock through its source pin
#                     rather than by auto-generated clock name (TIMING-28 cleanup).

# =========================================================================
# FH_Carrier PCIe Reference Clock Monitor
# PZ-ZU7EV / XCZU7EV
# =========================================================================

# M2_PCIE_REFCLK_SOM -> GTH Bank 223 MGTREFCLK0
# Actual top-level ports generated by the Block Design wrapper.

current_instance -quiet
set_property PACKAGE_PIN AD7 [get_ports M2_PCIE_REFCLK_SOM_N_0]
set_property PACKAGE_PIN AD8 [get_ports M2_PCIE_REFCLK_SOM_P_0]

# External PCIe reference clock = 100 MHz.


# IBUFDS_GTE4 ODIV2 is auto-derived after synthesis.  Do not constrain the
# internal ODIV2 pin in this synthesis-used XDC because the custom BD module is
# still a black box at this stage.  See FH_Carrier_Bringup_impl.xdc.


